#!/usr/bin/env bash
# expose-online — expose your local expose server to singlecore.dev
#
# Starts expose + an SSH reverse tunnel to the jumphost LXC.
# When the tunnel is live, https://singlecore.dev points to your local expose.
set -euo pipefail

# ── Config ────────────────────────────────────────────────────────────────────
TUNNEL_HOST="${TUNNEL_HOST:-213.118.201.119}"
TUNNEL_PORT="${TUNNEL_PORT:-47865}"
TUNNEL_USER="${TUNNEL_USER:-root}"
TUNNEL_RPORT="${TUNNEL_RPORT:-9090}"
TUNNEL_LPORT="${TUNNEL_LPORT:-9090}"

GREEN='\033[0;32m'; CYAN='\033[0;36m'; YLW='\033[1;33m'; NC='\033[0m'; DIM='\033[2m'

# ── State ─────────────────────────────────────────────────────────────────────
_STOPPED=0
SSH_PID=""
EXPOSE_PID=""

cleanup() {
  _STOPPED=1
  echo ""
  echo -e "${GREEN}Shutting down...${NC}"
  [ -n "$SSH_PID" ] && kill -9 $SSH_PID 2>/dev/null || true
  [ -n "$EXPOSE_PID" ] && kill -9 $EXPOSE_PID 2>/dev/null || true
  echo -e "${GREEN}Offline.${NC}"
  exit 0
}
trap cleanup INT TERM

# ── Pre-flight: free local port ───────────────────────────────────────────────
_local_pid=$(ss -tlnp "sport = :${TUNNEL_LPORT}" 2>/dev/null \
  | awk 'NR>1{match($0,/pid=([0-9]+)/,a); if(a[1]) print a[1]}' | head -1)
if [ -n "$_local_pid" ]; then
  _local_cmd=$(ps -p "$_local_pid" -o comm= 2>/dev/null || echo "unknown")
  echo -e "${DIM}Killing ${_local_cmd} (pid ${_local_pid}) on port ${TUNNEL_LPORT}${NC}"
  kill "$_local_pid" 2>/dev/null || true
  sleep 0.3
fi

# ── Start expose ──────────────────────────────────────────────────────────────
echo -e "${GREEN}Starting expose on localhost:${TUNNEL_LPORT}...${NC}"
expose --bind 127.0.0.1 -p "$TUNNEL_LPORT" "$@" &
EXPOSE_PID=$!
sleep 0.5

if ! kill -0 $EXPOSE_PID 2>/dev/null; then
  echo -e "${YLW}expose failed to start${NC}"
  exit 1
fi

# ── Pre-flight: free remote port ─────────────────────────────────────────────
echo -e "${DIM}Cleaning up remote port ${TUNNEL_RPORT}...${NC}"
ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new \
  -p "$TUNNEL_PORT" "${TUNNEL_USER}@${TUNNEL_HOST}" \
  "ss -tlnp 'sport = :${TUNNEL_RPORT}' 2>/dev/null | grep -q ':${TUNNEL_RPORT}' && fuser -k ${TUNNEL_RPORT}/tcp 2>/dev/null; true" \
  2>/dev/null || true

# ── SSH tunnel ────────────────────────────────────────────────────────────────
echo -e "${GREEN}Tunnel:${NC} localhost:${TUNNEL_LPORT} → ${TUNNEL_HOST}:${TUNNEL_RPORT} (via SSH :${TUNNEL_PORT})"
echo -e "${CYAN}https://singlecore.dev${NC} ← ready ${DIM}(once tunnel connects)${NC}"
echo ""

while [ $_STOPPED -eq 0 ]; do
  ssh -n \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=2 \
    -o ExitOnForwardFailure=yes \
    -o StrictHostKeyChecking=accept-new \
    -o ConnectTimeout=10 \
    -N -R "*:${TUNNEL_RPORT}:localhost:${TUNNEL_LPORT}" \
    -p "$TUNNEL_PORT" \
    "${TUNNEL_USER}@${TUNNEL_HOST}" &
  SSH_PID=$!

  wait $SSH_PID 2>/dev/null || true

  [ $_STOPPED -eq 1 ] && break

  if ! kill -0 $EXPOSE_PID 2>/dev/null; then
    echo -e "${YLW}expose died, exiting.${NC}"
    exit 1
  fi

  # ── Free remote port before reconnecting ─────
  ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new \
    -p "$TUNNEL_PORT" "${TUNNEL_USER}@${TUNNEL_HOST}" \
    "ss -tlnp 'sport = :${TUNNEL_RPORT}' 2>/dev/null | grep -q ':${TUNNEL_RPORT}' && fuser -k ${TUNNEL_RPORT}/tcp 2>/dev/null; true" \
    2>/dev/null || true

  echo -e "${YLW}Tunnel dropped, reconnecting in 3s...${NC}"
  sleep 3
done
