# Optional bootstrap configuration. Copy to env (ignored by Git).
# Defaults use the current user, current hostname, and this checkout.
# Explicit environment values take precedence over this file.
TARGET_USER="${TARGET_USER:-$USER}"
DESIRED_HOSTNAME="${DESIRED_HOSTNAME:-$(hostname)}"
DOTFILES_DIR="${DOTFILES_DIR:-${SCRIPT_DIR:-$HOME/Documents/core-dotfiles}}"
SSH_KEY_TYPE="${SSH_KEY_TYPE:-ed25519}"

# Never store credentials here, even in ignored local copies.
# Private expose-online settings belong in ~/.config/expose/online.env (0600).
# Shell credentials belong in ~/.config/core-dotfiles/secrets.zsh (0600).
