# Stow artifact directories (symlinks don't need tracking)
# But we want empty dirs preserved for stow structure

# OS junk
.DS_Store
Thumbs.db

# Editor
*~
*.swp
*.swo
.vscode/
.idea/

# User environment overrides (personal, not tracked)
env

# Secrets (ensure no API keys leak)
*.secret
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa
secrets.*
credentials.json
api_key
auth.json
online.env
.memory.local.md
.venv/

# Private runtime captures and credential-bearing security-tool output
.expose/
reports/
loot/
*.pcap
*.pcapng

# Python caches
__pycache__/
*.py[cod]

# Local agent runtime state
.omo/
